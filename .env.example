# CareIQ environment variables.
# Copy to .env.local for local dev. NEVER commit .env.local.
# In production, set these on Vercel only.

# --- Public site URL (used to build outbound URLs like Supabase magic-link
#     redirects). MUST be the canonical user-facing origin, no trailing slash.
#     Example production: https://care-iq-sable.vercel.app
#     Example local dev:   http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://care-iq-sable.vercel.app

# --- Supabase (server + browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service-role-key...
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon-key...
# Optional: server-side anon key only required if you serve user-scoped JWTs through getUserClient()
SUPABASE_ANON_KEY=

# --- Anthropic (server-side AI inference) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (transactional email for magic links) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# --- Encryption (AES-256-GCM key, 32 bytes hex encoded = 64 chars) ---
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f000102030405060708090a0b0c0d0e0f

# --- CSRF (HMAC secret, any high-entropy string) ---
# Generate: openssl rand -hex 32
CSRF_SECRET=replace-with-strong-random-hex
